{
  "name": "a name of an internal network with no scheme (catalog convention, the hub accepts it)",
  "accept": false,
  "hub_accepts": true,
  "item": {
    "kind": "template",
    "id": "example",
    "version": 1,
    "name": {
      "en": "Example",
